      "decision_rule": "U_90_percent(G_zero_PROP) <= 3.5e-4"
    },
    "secondary_estimands": {
      "C1-OA-S1-oracle_relative": {
        "estimand": "G_suf(PROP-DIRECT) - G_suf(B-INDEP) using the frozen same_info_metric oracle reference",
        "direction": "lower",
        "decision_rule": "report estimate and 90% CI; no primary rescue",
        "role": "descriptive_secondary"
      },
      "C1-OA-S2-baseline_comparison": {
        "estimands": [
          "PROP-DIRECT vs B-STDPROB",
          "B-INDEP vs B-STDPROB"
        ],
        "role": "diagnostic_secondary"
      }
    },
    "required_guardrails": [
      "support_and_finiteness",
      "pair_and_asset_coverage",
      "state_failure_mae_inherited_limits",
      "no_direction_reversal_between_test_and_lockbox",
      "same_evaluator_convention_for_all_models"
    ],
    "failure_states": {
      "contract_or_provenance_failure": "INVALID-CONTRACT-VIOLATION",
      "missing_or_nonfinite_metric": "NON-ESTIMABLE-EXECUTION-HOLD",
      "primary_or_absolute_guardrail_failure": "C1-CORE-FAIL",
      "primary_pass_guardrail_unresolved": "C1-INTERPRETATION-HOLD"
    }
  },
  "metric_contract": {
